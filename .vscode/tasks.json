{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Web Server",
      "type": "shell",
      "command": "/usr/bin/python3",
      "args": ["-m", "http.server", "8080", "--bind", "127.0.0.1"],
      "options": {
        "cwd": "${workspaceFolder}"
